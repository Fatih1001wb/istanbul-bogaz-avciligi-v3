# Supabase proje ayarlarından (Settings > API) alınır
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth kurulumu (Supabase Dashboard):
# 1. Authentication > Providers > Google → Enable
# 2. Google Cloud Console'da OAuth 2.0 Client ID oluşturun
# 3. Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 4. Site URL: http://localhost:5173 (geliştirme)
# 5. Redirect URLs: http://localhost:5173/** ve production domain
